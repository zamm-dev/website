---
import type { BlogPost } from '../content/config';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import ReleaseLinks from '../components/ReleaseLinks.astro';
import DiscussionLinks from '../components/DiscussionLinks.astro';
import type { MarkdownHeading } from 'astro';

type Props = BlogPost & { headings: MarkdownHeading[] };

const data = Astro.props;
const {
	zammVersion, title, description, pubDate, updatedDate, heroImage, headings,
} = data;
const fullTitle = `v${zammVersion} - ${title}`;
const descriptionText = description ?? `Blog post for v${zammVersion}`;
const postHistoryUrl = `https://github.com/zamm-dev/website/commits/main/src/content/blog/v${zammVersion}.mdx`;
---

<html lang="en">
	<head>
		<BaseHead title={fullTitle} description={descriptionText} image={heroImage} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: fit-content;
				margin: 0 auto 3em;
			}
			.hero-image img {
				display: block;
				max-height: 500px;
				max-width: min(950px, 100%);
				width: auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.blog-post-body {
				width: 720px;
				max-width: 100%;
				margin: auto;
				color: rgb(var(--gray-dark));
			}
			@media (min-width: 720px) {
				.blog-post-body {
					padding: 1em;
					max-width: calc(100% - 2em);
				}
			}
			.prose :global(li p:first-of-type) {
				margin-top: 0.5em;
			}
			.prose :global(li p:last-of-type) {
				margin-bottom: 0.5em;
			}
			.prose :global(.signature) {
				margin-left: auto;
				text-align: right;
			}
			.prose :global(.signature p) {
				margin: 0;
			}
			.prose :global(sup[data-footnote-ref]) {
				line-height: 0;
			}
			.prose :global(sup[data-footnote-ref] a) {
				text-decoration: none;
			}
			.prose :global(section[data-footnotes]) {
				position: relative;
				margin: 3rem 2rem 0;
				padding-top: 1.5rem;
				font-size: 22px;
				line-height: 1.8rem;
			}
			.prose :global(section[data-footnotes]::before) {
				content: '';
				position: absolute;
				top: 0;
				left: -2rem;
				right: -2rem;
				border-top: 1px solid rgb(var(--gray-light));
			}
			.prose :global(section[data-footnotes] h2) {
				margin-bottom: 1rem;
				font-size: 1rem;
				letter-spacing: 0.04em;
				text-transform: uppercase;
			}
			.prose :global(section[data-footnotes] ol) {
				padding-left: 1.5rem;
			}
			.prose :global(section[data-footnotes] li) {
				margin-bottom: 1rem;
			}
			.prose :global(section[data-footnotes] p) {
				margin: 2rem 0;
			}
			.prose :global(a[data-footnote-backref]) {
				margin-left: 0.35rem;
				text-decoration: none;
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				{heroImage && (
					<div class="hero-image">
						<img width={1020} height={510} src={heroImage} alt="" />
					</div>
				)}
				<div class="title">
					<h1><span class="version">v{zammVersion}: </span>{title}</h1>
					<table class="dates">
						<tr>
							<td>Published</td>
							<td class="date"><FormattedDate date={pubDate} /></td>
						</tr>
						{
							updatedDate && (
								<tr>
									<td><a href={postHistoryUrl}>Last update</a></td>
									<td class="date"><FormattedDate date={updatedDate} /></td>
								</tr>
							)
						}
					</table>
				</div>
				<div class="blog-post-body">
					<ReleaseLinks release={data} {headings} />
					<div class="prose">
						<slot />
					</div>
					<DiscussionLinks {...data.discussions} />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
