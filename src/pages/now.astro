---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_DESCRIPTION } from "../consts";
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="What I'm Doing Now" description={SITE_DESCRIPTION} />
		<style>
			h1 {
				font-family: "Nasalization", Arial, Helvetica, sans-serif;
				color: var(--accent-darker);
				font-weight: 400;
			}

			h2 {
				font-family: "Nasalization", Arial, Helvetica, sans-serif;
				margin-top: 2rem;
			}

			main p,
			ul {
				font-family: "EB Garamond", "Battambang", serif;
				font-size: 26px;
			}

			ul {
				line-height: 1.8;
			}

			main p.updated {
				font-family: "Good Timing", Arial, Helvetica, sans-serif;
				color: var(--gray);
				font-size: 20px;
				margin: 0;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>Me Now</h1>
			<p class="updated">Or at least, me as of June 2026</p>

			<p style="margin-top: 2rem;">
				I'm <a
					href="https://nownownow.com/about"
					target="_blank"
					rel="noopener noreferrer">currently</a
				> enjoying life in Siem Reap, Cambodia. I run a software consulting agency called <a href="https://meksys.com/">Meksys</a> with my business partner, where we use the latest advances in AI coding to build high-quality software at low cost. I regularly chronicle the ongoing gradual unfolding of my spiritual development.
			</p>
		</main>
		<Footer />
	</body>
</html>
